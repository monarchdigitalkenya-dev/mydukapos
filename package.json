{
  "name": "monarchpos-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "acorn": "^8.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.0",
    "wrangler": "^3.78.0"
  },
  "scripts": {
    "sync": "node tools/sync-shared.mjs",
    "check": "node tools/sync-shared.mjs --check",
    "drift": "node tools/drift-report.mjs",
    "deploy": "npm run check && npm test && wrangler pages deploy . --project-name=mydukapos --branch=mydukapos",
    "test": "node tools/test.mjs",
    "deploy:fast": "npm run check && wrangler pages deploy . --project-name=mydukapos --branch=mydukapos",
    "deploy:staging": "npm run check && node tools/deploy-staging.mjs",
    "deploy:router": "wrangler deploy --config wildcard-router/wrangler.toml",
    "deploy:router:staging": "wrangler deploy --config wildcard-router/wrangler.staging.toml",
    "lint": "node tools/lint-globals.mjs",
    "gen:migration": "node tools/gen-migration.mjs",
    "guides": "node tools/build-guides.mjs"
  }
}
