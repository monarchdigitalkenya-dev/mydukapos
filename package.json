{
  "name": "monarchpos-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "acorn": "^8.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.0",
    "wrangler": "^4.0.0"
  },
  "scripts": {
    "sync": "node tools/sync-shared.mjs",
    "check": "node tools/sync-shared.mjs --check && node tools/build-home-cards.mjs --check && node tools/inject-owner-pro.mjs --check",
    "drift": "node tools/drift-report.mjs",
    "deploy": "npm run check && npm test && node tools/deploy-pages.mjs",
    "test": "node tools/test.mjs",
    "deploy:fast": "npm run check && node tools/deploy-pages.mjs",
    "target": "node tools/deploy-target.mjs --show",
    "target:production": "node tools/deploy-target.mjs --production",
    "target:preview": "node tools/deploy-target.mjs --preview",
    "deploy:staging": "npm run check && node tools/deploy-staging.mjs",
    "deploy:router": "node tools/ensure-router-config.mjs && wrangler deploy --config wildcard-router/wrangler.toml",
    "deploy:router:staging": "node tools/ensure-router-config.mjs && wrangler deploy --config wildcard-router/wrangler.staging.toml",
    "lint": "node tools/lint-globals.mjs",
    "gen:migration": "node tools/gen-migration.mjs",
    "guides": "node tools/build-guides.mjs",
    "build:public": "node tools/build-public-pages.mjs",
    "db:backup": "tools\\backup-all.cmd",
    "db:migrate": "wrangler d1 migrations apply mydukapos-ledger --remote",
    "build:cards": "node tools/build-home-cards.mjs",
    "seo": "node tools/seo-check.mjs",
    "owner:pro": "node tools/inject-owner-pro.mjs"
  }
}
