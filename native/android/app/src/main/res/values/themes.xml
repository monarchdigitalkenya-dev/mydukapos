<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: the app's own icon on its own colour (per app — see resValue 'brand' in app/build.gradle) -->
    <style name="Theme.MyDuka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MyDuka</item>
    </style>
    <style name="Theme.MyDuka" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
