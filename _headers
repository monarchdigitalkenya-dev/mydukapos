# Cloudflare Pages static headers (zip 159). Only STATIC files are affected; /api answers set their own headers in functions/api/_middleware.js.
# Pages already serves every static file with an ETag and revalidates it, so nothing here makes an app file stay stale: the app HTML, JS
# and CSS are deliberately NOT given a long max-age (they are not fingerprinted and a new release must reach every till at once).

# Icons and images never change without a new file name in practice: let the browser and the edge reuse them for a day, and serve a stale
# copy for a week while it refreshes in the background.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

# A service worker must always be re-checked (the browser does this by itself, this makes an intermediary do the same).
/sw.js
  Cache-Control: no-cache
/*/sw.js
  Cache-Control: no-cache

# zip 177 — baseline security headers for every static file. (/api answers get nosniff from functions/api/_middleware.js.) HSTS has no
# includeSubDomains on purpose: only the names that are known to be HTTPS-only should ever be pinned.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=15552000

# zip 177 — the POS apps and the Owner Console are private: never searchable (their pages also carry <meta name="robots" content="noindex">
# and a shop's own host gets the same header from functions/_middleware.js).
/hotel/*
  X-Robots-Tag: noindex, nofollow
/hospital/*
  X-Robots-Tag: noindex, nofollow
/pharmacy/*
  X-Robots-Tag: noindex, nofollow
/production/*
  X-Robots-Tag: noindex, nofollow
/services/*
  X-Robots-Tag: noindex, nofollow
/water/*
  X-Robots-Tag: noindex, nofollow
/order/*
  X-Robots-Tag: noindex, nofollow
/owner/*
  X-Robots-Tag: noindex, nofollow
